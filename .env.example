FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
MONGO_URI=mongodb://localhost:27017/return_tech
JWT_SECRET_KEY=SUBSTITUIR_POR_UMA_CHAVE_PRIVADA_LONGA
FRONTEND_URL=http://localhost:5173

# Gmail: use uma senha de app, nunca a senha comum da conta.
# O envio só é ativado quando MAIL_ENABLED=true e a configuração está completa.
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=
MAIL_FROM=seu-email@gmail.com
MAIL_FROM_NAME=Return Tech

# O prazo vale até o fim do dia neste fuso horário.
CHALLENGE_TIMEZONE=America/Sao_Paulo
BACKGROUND_JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=30
