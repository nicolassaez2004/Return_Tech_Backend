FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
MONGO_URI=mongodb://localhost:27017/return_tech
JWT_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
FRONTEND_URL=http://localhost:5173

# Gmail: use uma senha de app, nunca a senha comum da conta.
# O envio só é ativado quando MAIL_ENABLED=true e a configuração está completa.
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=returntech0@gmail.com
MAIL_PASSWORD=
MAIL_FROM=returntech0@gmail.com
MAIL_FROM_NAME=Return Tech

# O prazo vale até o fim do dia neste fuso horário.
CHALLENGE_TIMEZONE=America/Sao_Paulo
BACKGROUND_JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=30

# Judge0 local: preencha o token privado apenas no .env deste computador.
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=
JUDGE0_AUTH_TOKEN=
